# 作用：环境变量示例模板，列出模型接口与 Docker 沙箱的全部可配置项。
# 使用位置：复制为 .env.local 后由 Next.js 服务端进程（process.env）读取。
# 输入：用户填写的值（模型地址/密钥、Docker 连接、空闲超时等）。
# 输出：供 app/api/chat/route.ts、lib/docker.ts、lib/sandbox.ts 使用的运行时配置。

# 模型接口（也可以在界面「设置」里填写，界面优先级更高）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 回复语言：zh-CN（默认，始终中文）/ auto（跟随用户输入）/ en
AGENT_LANGUAGE=zh-CN

# Docker 连接方式
# DOCKER_HOST：docker daemon 地址，默认走本机 2375 端口
DOCKER_HOST=tcp://localhost:2375
# DOCKER_MODE=wsl 表示用 WSL 里的 docker CLI 去连上面的地址；host 表示用本机 docker CLI
DOCKER_MODE=wsl
# WSL 发行版名称，可用 wsl -l -q 查看；留空表示使用默认发行版
WSL_DISTRO=Ubuntu-24.04
# 若 WSL 内访问不到 Windows 的 localhost:2375，可单独指定（例如宿主机网关 IP）
# WSL_DOCKER_HOST=tcp://172.20.0.1:2375
# 可选：wsl.exe 路径 / docker 可执行文件路径
# WSL_EXE=C:\\Windows\\System32\\wsl.exe
# DOCKER_BIN=docker

# 沙箱默认镜像与工作目录
SANDBOX_IMAGE=ubuntu:24.04
SANDBOX_WORKDIR=/workspace

# 是否把容器的 /workspace 挂载到宿主机目录（1 开启 / 0 关闭，默认 1）
SANDBOX_MOUNT=1
# 挂载源目录，默认项目根目录下的 workspace（WSL 模式会自动转成 /mnt/<盘符>/... 形式）
# SANDBOX_HOST_WORKSPACE=/home/user/mini-codex-workspace

# 会话空闲多久后销毁对应的临时容器（毫秒，默认 600000 = 10 分钟，最小 30000）
SANDBOX_IDLE_TIMEOUT_MS=600000
